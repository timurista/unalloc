# Copy to .env and fill in. unalloc reads these from the environment; it never
# writes them anywhere and stores no credentials or cost data on disk.

# --- Kubernetes infrastructure spend ---------------------------------------
# In-cluster service address, or localhost after:
#   kubectl -n opencost port-forward svc/opencost 9003:9003
UNALLOC_OPENCOST_URL=http://localhost:9003

# --- LLM API spend ---------------------------------------------------------
# Preferred source when you run a LiteLLM proxy: it already attributes per key,
# team and tag. If you use this, skip the direct provider adapters below or you
# will double count the same tokens.
UNALLOC_LITELLM_URL=http://localhost:4000
UNALLOC_LITELLM_KEY=

# Direct provider billing APIs. Both need ORG ADMIN keys, not regular API keys.
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=
